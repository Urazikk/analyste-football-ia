{"id": "doc-07", "type": "doc", "level": 3, "answer": "Les lignes de la surface de réparation sont tracées à **16,5 m de l’intérieur de chaque poteau**, perpendiculairement à la ligne de but [ifab-loi-01#6-surface-de-reparation/1].", "sources": ["ifab-loi-01#6-surface-de-reparation/1"], "retrieved": ["ifab-loi-01#6-surface-de-reparation/1", "wiki-loi-1-du-football#surface-de-reparation/1", "ifab-loi-01#6-surface-de-reparation/2"], "abstained": false, "clarified": false, "refused": false, "tool_calls": [{"name": "search_rules", "arguments": "{\"query\": \"dimensions surface de réparation distance des poteaux lignes tracées 16,5 mètres\", \"k\": 3}", "output": "{\"ok\": true, \"ids\": [\"ifab-loi-01#6-surface-de-reparation/1\", \"wiki-loi-1-du-football#surface-de-reparation/1\", \"ifab-loi-01#6-surface-de-reparation/2\"], \"error\": null}"}], "pending_action": null, "tokens_in": 2616, "tokens_out": 101, "latency_s": 3.0316547429997627, "steps": 2, "stop_reason": "final", "error": null, "trace_path": "/home/user/analyste-football-ia/traces/20261116-160355-1a32cd.jsonl", "recall@5": 1.0, "mrr": 1.0, "correct": true, "cited": true, "faithful": true, "judge_unsupported": [], "judge_tokens": 400, "trial": 0, "model": "gpt-6-luna"}
