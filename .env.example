# Copier en .env et remplir. Ne jamais committer .env.

# LLM via une API compatible OpenAI (Groq, Mistral, Ollama...). Clé gratuite : console.groq.com
# Mistral : LLM_BASE_URL=https://api.mistral.ai/v1  LLM_MODEL=mistral-small-latest
# Ollama local : LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# OpenAI (clé fournie par l'encadrant, modèle gpt-6-luna uniquement) :
#   LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-6-luna  LLM_REASONING_EFFORT=none
#   JUDGE_BASE_URL=https://api.groq.com/openai/v1  JUDGE_API_KEY=<clé Groq>
# Effort de raisonnement (vide : non envoyé). gpt-6-luna : none, exigé pour les appels d'outils et la température 0
LLM_REASONING_EFFORT=
# Température du modèle évalué ; vide : valeur par défaut du modèle
LLM_TEMPERATURE=0
# Tokens de sortie par appel (raisonnement compris pour les modèles qui raisonnent)
LLM_MAX_TOKENS=1024

# Modèle d'embeddings (sentence-transformers, local)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Juge de fidélité (autre famille que LLM_MODEL)
JUDGE_MODEL=qwen/qwen3.8-27b
# Fournisseur du juge s'il diffère de celui du modèle évalué (vide : le même)
JUDGE_BASE_URL=
JUDGE_API_KEY=
# Tarif (USD par million de tokens) : vide, le tarif du modèle vient de src/config.py (PRICES)
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=

# Bornes de l'agent
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=20000

SEED=42
